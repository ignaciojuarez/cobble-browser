# Cobble → $HOME/Developer/build-kit/macos/run.sh (build-kit)
# Empty XCODE_APP = newest /Applications/Xcode*.app (betas included).

APP_NAME=Cobble
PROJECT=Cobble.xcodeproj
SCHEME=Cobble
PRODUCT_NAME=Cobble
BUNDLE_ID=com.ignacio.cobble

XCODE_APP="${XCODE_APP:-${COBBLE_XCODE:-}}"
TEAM_ID="${TEAM_ID:-${COBBLE_DEVELOPMENT_TEAM:-}}"
SEND_TARGET="${SEND_TARGET:-${COBBLE_SEND_TARGET:-}}"
TAILDROP_ROOT='~/Documents/taildrop'

# Fast and Full use the same certificate identity.
ALLOW_ADHOC_SEND=0

HOOK_FULL=Scripts/hook_full.sh
