    "Web Inspector" : {
      "extractionState" : "stale",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inspector web"
          }
        }
      }
    },
    "WebKit did not change this tab’s audio mute state." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WebKit no cambió el estado de silencio de audio de esta pestaña."
          }
        }
      }
    },
    "WebKit did not return the current page DOM." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WebKit no devolvió el DOM actual de la página."
          }
        }
      }
    },
    "WebKit pages appear in Safari’s Develop menu. Chromium pages open from View > Open Developer Tools. Enable this only while debugging." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las páginas WebKit aparecen en el menú Desarrollo de Safari. Las páginas Chromium se abren desde Visualización > Abrir herramientas para desarrolladores. Activa esta opción solo durante la depuración."
          }
        }
      }
    },
    "WebKit remembers zoom for each site in normal windows. Actual Size resets that site to 100%. Private-window zoom stays local. Forgetting permissions keeps your zoom preferences." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WebKit recuerda el zoom de cada sitio en ventanas normales. Tamaño real restablece ese sitio al 100 %. El zoom de las ventanas privadas se conserva localmente. Olvidar permisos mantiene tus preferencias de zoom."
          }
        }
      }
    },
    "Website access" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acceso a sitios web"
          }
        }
      }
    },
    "WebKit could not verify the shared cookies. Sign in again in this engine." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WebKit no pudo verificar las cookies compartidas. Vuelve a iniciar sesión en este motor."
          }
        }
      }
    },
    "WebKit did not remove the previous cookies. Sign out again in this engine." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WebKit no eliminó las cookies anteriores. Vuelve a cerrar sesión en este motor."
          }
        }
      }
    },
    "WebKit has a cookie that cannot be safely shared. Sign in again in this engine." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WebKit tiene una cookie que no se puede compartir de forma segura. Vuelve a iniciar sesión en este motor."
          }
        }
      }
    },
    "WebKit has an unsupported SameSite cookie." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WebKit tiene una cookie SameSite no compatible."
          }
        }
