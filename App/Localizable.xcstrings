{
  "sourceLanguage" : "en",
  "strings" : {
    "A page was unloaded because camera or microphone capture could not be stopped safely. Unsaved page content may be lost." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se descargó una página porque no se pudo detener de forma segura la captura de cámara o micrófono. Puede que se haya perdido el contenido sin guardar."
          }
        }
      }
    },
    "Content blocker settings cannot be read or saved." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pueden leer ni guardar los ajustes del bloqueador de contenido."
          }
        }
      }
    },
    "Content blocker settings changed locally during sync. Retrying." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los ajustes del bloqueador de contenido cambiaron localmente durante la sincronización. Se volverá a intentar."
          }
        }
      }
    },
    "Content blocker exceptions changed locally during sync. Retrying." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las excepciones del bloqueador de contenido cambiaron localmente durante la sincronización. Se volverá a intentar."
          }
        }
      }
    },
    "Content blocker sync is paused because rules removed on another device are still installed on this Mac." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sincronización del bloqueador de contenido está pausada porque las reglas eliminadas en otro dispositivo siguen instaladas en este Mac."
          }
        }
      }
    },
    "Local content rules cannot be synced. Remove or replace them before syncing content blockers." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las reglas de contenido locales no se pueden sincronizar. Elimínalas o reemplázalas antes de sincronizar los bloqueadores de contenido."
          }
        }
      }
    },
    "A local content blocker source cannot be replaced by sync." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sincronización no puede reemplazar una fuente local de bloqueo de contenido."
          }
        }
      }
    },
    "Local custom content rules cannot be replaced by sync." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sincronización no puede reemplazar las reglas de contenido personalizadas locales."
          }
        }
      }
    },
    "A profile removed on another device still has local saved items. Move or delete them before syncing." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un perfil eliminado en otro dispositivo todavía tiene elementos guardados locales. Muévelos o elimínalos antes de sincronizar."
          }
        }
      }
    },
    "Content rules are unavailable." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las reglas de contenido no están disponibles."
          }
        }
      }
    },
    "Invalid content blocker exception." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Excepción del bloqueador de contenido no válida."
          }
        }
      }
    },
    "Bookmarks, tabs, history, site zoom, and content blockers require Spaces, pins, and favorites." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los marcadores, las pestañas, el historial, el zoom de sitios y los bloqueadores de contenido requieren Espacios, pestañas fijadas y favoritos."
          }
        }
      }
    },
    "Changes waiting to sync" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cambios pendientes de sincronización"
          }
        }
      }
    },
    "Content blocker source installation" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Instalación de la fuente del bloqueador de contenido"
          }
        }
      }
    },
    "Content rules are unavailable on this device." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las reglas de bloqueo no están disponibles en este dispositivo."
          }
        }
      }
    },
    "Could not install bundled content rules." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudieron instalar las reglas de bloqueo incluidas."
          }
        }
      }
    },
    "Could not install content rules from the update source." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudieron instalar las reglas de bloqueo desde la fuente de actualización."
          }
        }
      }
    },
    "Could not save content blocker exceptions." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudieron guardar las excepciones del bloqueador de contenido."
          }
        }
      }
    },
    "Could not save content blocker source." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo guardar la fuente del bloqueador de contenido."
          }
        }
      }
    },
    "Could not save content blocker state." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo guardar el estado del bloqueador de contenido."
          }
        }
      }
    },
    "Local custom content rules prevent synced bundled rules from being installed." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las reglas de bloqueo personalizadas de este dispositivo impiden instalar las reglas incluidas sincronizadas."
          }
        }
      }
    },
    "A tab changed while syncing. Sync will try again later." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una pestaña cambió durante la sincronización. Se intentará de nuevo más tarde."
          }
        }
      }
    },
    "A profile was removed on another device. Close its windows to finish syncing. Website data will remain on this Mac." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se eliminó un perfil en otro dispositivo. Cierra sus ventanas para terminar la sincronización. Los datos de los sitios web permanecerán en este Mac."
          }
        }
      }
    },
    "Content blockers" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bloqueadores de contenido"
          }
        }
      }
    },
    "Sync blocking preferences and exceptions for matching web engines." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sincroniza las preferencias de bloqueo y las excepciones de los motores web correspondientes."
          }
        }
      }
    },
    "Sync will resume after profile deletion finishes." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sincronización se reanudará cuando termine la eliminación del perfil."
          }
        }
      }
    },
    "Sync received unsupported or invalid data. Update Cobble before trying again." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sincronización recibió datos no compatibles o no válidos. Actualiza Cobble antes de volver a intentarlo."
          }
        }
      }
    },
    "Sync is off" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sincronización está desactivada"
          }
        }
      }
    },
    "Sync data could not be read. The original file has been preserved." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudieron leer los datos de sincronización. Se conservó el archivo original."
          }
        }
      }
    },
    "Ready to sync" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Listo para sincronizar"
          }
        }
      }
    },
    "Sync storage is unavailable." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El almacenamiento de sincronización no está disponible."
          }
        }
      }
    },
    "Syncing…" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sincronizando…"
          }
        }
      }
    },
    "Your iCloud account changed. Sync is paused. Turning sync on again uploads local-only items and uses the new account’s cloud values for matching items." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu cuenta de iCloud cambió. La sincronización está en pausa. Al volver a activarla, se subirán los elementos que solo existen en este Mac y se usarán los valores de la nueva cuenta para los elementos coincidentes."
          }
        }
      }
    },
    "The iCloud account changed during sync. Try again." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La cuenta de iCloud cambió durante la sincronización. Inténtalo de nuevo."
          }
        }
      }
    },
    "Up to date" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Actualizado"
          }
        }
      }
    },
    "Sync paused. Will retry automatically." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sincronización en pausa. Se reintentará automáticamente."
          }
        }
      }
    },
    "This Cobble build has no iCloud sync entitlement." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta versión de Cobble no tiene autorización para sincronizar con iCloud."
          }
        }
      }
    },
    "Sign in to iCloud to sync Cobble." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inicia sesión en iCloud para sincronizar Cobble."
          }
        }
      }
    },
    "The iCloud account changed. Reset sync state before continuing." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La cuenta de iCloud cambió. Restablece el estado de sincronización antes de continuar."
          }
        }
      }
    },
    "The saved iCloud sync cursor is invalid." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El cursor de sincronización de iCloud guardado no es válido."
          }
        }
      }
    },
    "An iCloud sync record is invalid." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un registro de sincronización de iCloud no es válido."
          }
        }
      }
    },
    "A sync record was removed from iCloud outside Cobble." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se eliminó un registro de sincronización de iCloud fuera de Cobble."
          }
        }
      }
    },
    "An iCloud record changed repeatedly during sync." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un registro de iCloud cambió repetidamente durante la sincronización."
          }
        }
      }
    },
    "iCloud Sync" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sincronización con iCloud"
          }
        }
      }
    },
    "Sync across devices" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sincronizar entre dispositivos"
          }
        }
      }
    },
    "Use your iCloud account to keep selected browser data on your Macs. Each Mac can choose its own web engine and window layout." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa tu cuenta de iCloud para mantener los datos seleccionados del navegador en tus Mac. Cada Mac puede elegir su propio motor web y diseño de ventanas."
          }
        }
      }
    },
    "Turning sync off on this Mac stops transfers. It does not erase data from iCloud or other devices." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desactivar la sincronización en este Mac detiene las transferencias. No borra los datos de iCloud ni de otros dispositivos."
          }
        }
      }
    },
    "Sync Now" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sincronizar ahora"
          }
        }
      }
    },
    "Last synced: %@" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Última sincronización: %@"
          }
        }
      }
    },
    "Choose what syncs" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige qué sincronizar"
          }
        }
      }
    },
    "Spaces and profiles provide the home for pins, bookmarks, tabs, history, site zoom, and content blockers. Keep Organization on to sync those categories." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los espacios y perfiles organizan los elementos fijados, marcadores, pestañas, historial, zoom de sitios y bloqueadores de contenido. Mantén Organización activada para sincronizar esas categorías."
          }
        }
      }
    },
    "Passwords, cookies, private tabs, and downloads stay on this Mac." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las contraseñas, cookies, pestañas privadas y descargas permanecen en este Mac."
          }
        }
      }
    },
    "A page kept its tab open. Sync will try again later." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una página mantuvo su pestaña abierta. La sincronización lo intentará de nuevo más tarde."
          }
        }
      }
    },
    "Could not open a window for synced tabs." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo abrir una ventana para las pestañas sincronizadas."
          }
        }
      }
    },
    "Spaces, pins, and favorites" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Espacios, pestañas fijadas y favoritos"
          }
        }
      }
    },
    "Open tabs" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pestañas abiertas"
          }
        }
      }
    },
    "Search and shortcuts" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Búsqueda y atajos"
          }
        }
      }
    },
    "Site zoom" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zoom de sitios"
          }
        }
      }
    },
    "Includes folders and profile names. Website logins stay on each device." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Incluye carpetas y nombres de perfil. Las sesiones web permanecen en cada dispositivo."
          }
        }
      }
    },
    "Keep your saved library bookmarks available on every device." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén los marcadores de tu biblioteca disponibles en todos tus dispositivos."
          }
        }
      }
    },
    "Keep tabs in your spaces in sync. Opening or closing a tab updates your other devices." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sincroniza las pestañas de tus espacios. Abrir o cerrar una pestaña actualiza tus otros dispositivos."
          }
        }
      }
    },
    "Include browsing history. Private browsing is never included." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Incluye el historial de navegación. La navegación privada nunca se incluye."
          }
        }
      }
    },
    "Sync search engines, keyboard shortcuts, and tab behavior." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sincroniza los motores de búsqueda, atajos de teclado y el comportamiento de las pestañas."
          }
        }
      }
    },
    "Remember website zoom levels. Website permissions stay on this Mac." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recuerda el zoom de los sitios web. Los permisos permanecen en este Mac."
          }
        }
      }
    },
    "Login sharing was skipped during sign-in. Destination cookies were left unchanged." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se omitió compartir el inicio de sesión durante la autenticación. Las cookies de destino no se modificaron."
          }
        }
      }
    },
    "No transferable source cookies were found. Destination cookies were left unchanged." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se encontraron cookies de origen transferibles. Las cookies de destino no se modificaron."
          }
        }
      }
    },
    "Destination cookies could not be read safely. Destination cookies were left unchanged." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudieron leer las cookies de destino de forma segura. No se modificaron."
          }
        }
      }
    },
    "Some destination cookies cannot be safely replaced. Destination cookies were left unchanged." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Algunas cookies de destino no se pueden reemplazar de forma segura. No se modificaron."
          }
        }
      }
    },
    "Destination cookies already match the source. No cookies were copied." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las cookies de destino ya coinciden con las de origen. No se copió ninguna cookie."
          }
        }
      }
    },
    "Existing destination cookies were preserved. Sign in again if needed." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se conservaron las cookies de destino existentes. Inicia sesión de nuevo si es necesario."
          }
        }
      }
    },
    "Destination cookies changed during transfer. Destination cookies were left unchanged." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las cookies de destino cambiaron durante la transferencia. No se modificaron."
          }
        }
      }
    },
    "Replace existing website cookies?" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Reemplazar las cookies existentes del sitio web?"
          }
        }
      }
    },
    "%@ already has cookies for this website. Replacing them may sign you out or change accounts. Keep them, or replace them with cookies from the current engine?" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ya tiene cookies de este sitio web. Reemplazarlas puede cerrar la sesión o cambiar de cuenta. ¿Conservarlas o reemplazarlas con las cookies del motor actual?"
          }
        }
      }
    },
    "Keep Existing" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conservar existentes"
          }
        }
      }
    },
    "Replace Cookies" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reemplazar cookies"
          }
        }
      }
    },
    "Attempts to carry login cookies when switching engines within the same profile. Existing cookies are kept unless you choose to replace them. Private windows are excluded. Some sites still require sign-in. Requires a compatible Full build." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Intenta transferir las cookies de inicio de sesión al cambiar de motor dentro del mismo perfil. Las cookies existentes se conservan salvo que elijas reemplazarlas. Se excluyen las ventanas privadas. Algunos sitios aún requieren iniciar sesión. Requiere una compilación Full compatible."
          }
        }
      }
    },
    "!%@ — %@" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "!%1$@ — %2$@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "!%@ — %@"
          }
        }
      }
    },
    "%@ — %@" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ — %@"
          }
        }
      }
    },
    "%@ %@" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ %@"
          }
        }
      }
    },
    "%@ cannot delete its profile data yet. No profile data was removed." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ todavía no puede eliminar los datos de su perfil. No se eliminó ningún dato del perfil."
          }
        }
      }
    },
    "%@ cannot prepare to delete its profile data. No profile data was removed: %@" : {
      "localizations" : {
        "es" : {
